{
  "name": "gymtrace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "test": "npm run test:unit && npm run test:emu",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-gymtrace",
    "dev:emu": "VITE_USE_EMULATORS=true VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_PROJECT_ID=demo-gymtrace VITE_FIREBASE_AUTH_DOMAIN=localhost vite",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:emu": "firebase emulators:exec --only auth,firestore --project demo-gymtrace \"node --test --test-concurrency=1 tests/rules/*.test.mjs tests/api/*.test.mjs\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.34.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.1"
  }
}
