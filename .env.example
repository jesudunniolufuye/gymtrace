# Copy to .env.local for local dev. Never commit real values.

# --- Browser (public Firebase web config: Firebase console > Project settings > Your apps > Web app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (Vercel API functions, from phase 2). SECRET: set in Vercel, never in git ---
# Entire service-account JSON on one line (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT=
# Long random string used to sign QR codes (phase 3), e.g. `openssl rand -base64 48`
QR_SIGNING_SECRET=

# --- Seed script only (npm run seed). Use instead of FIREBASE_SERVICE_ACCOUNT locally ---
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_MEMBER_EMAIL=
# SEED_MEMBER_PASSWORD=
# SEED_TRAINER_EMAIL=
# SEED_TRAINER_PASSWORD=
