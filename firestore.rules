rules_version = '2';

// GymTrace Firestore security rules.
//
// Principles:
//  - The browser is untrusted. Anything that grants access or money-like value
//    (role, subscription, payments, attendance) is written only by the server
//    (Vercel API functions using firebase-admin, which bypasses these rules)
//    or by an admin.
//  - Users must have verified their email, and not be deactivated, before
//    they can touch app data. The only exceptions are creating and reading
//    their own profile (registration happens before verification, and a
//    deactivated user needs to see that they are deactivated).
//  - Anything not matched below is denied by default (errorLogs, qrNonces,
//    sessions, ...).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Verified email AND an account that an admin has not deactivated.
    // A deactivated user can still read their own profile (to see why).
    function active() {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'disabled';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return active()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == role;
    }

    function isAdmin() { return hasRole('admin'); }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validName(v)  { return v is string && v.size() >= 2 && v.size() <= 80; }
    function validPhone(v) { return v is string && v.size() <= 20; }

    // ---------- users ----------
    // Self-registration may only create a member or a trainer. Trainers start
    // 'inactive' until an admin activates them. Role, status and any
    // subscription data can never be changed by the user themselves.
    match /users/{userId} {
      allow read: if isSelf(userId)
        || isAdmin()
        || (active() && resource.data.role == 'trainer');

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'phone', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'phone', 'status', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone == ''
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.role == 'member'  && request.resource.data.status == 'active') ||
          (request.resource.data.role == 'trainer' && request.resource.data.status == 'inactive')
        );

      allow update: if isAdmin()
        || (isSelf(userId) && active()
            && changedOnly(['name', 'phone'])
            && validName(request.resource.data.name)
            && validPhone(request.resource.data.phone));

      allow delete: if isAdmin();
    }

    // ---------- attendance ----------
    // Check-ins are created only by the server (POST /api/check-in), which
    // verifies the QR code and the member's payment. Not even an admin can
    // create one from the browser. A member may only close (check out)
    // their own open record.
    match /attendance/{docId} {
      allow read: if isAdmin() || (active() && resource.data.memberId == request.auth.uid);

      allow create: if false;
      allow delete: if isAdmin();

      allow update: if isAdmin()
        || (active()
            && resource.data.memberId == request.auth.uid
            && resource.data.status == 'Active'
            && changedOnly(['checkOut', 'status'])
            && request.resource.data.status == 'Completed'
            && request.resource.data.checkOut == request.time);
    }

    // ---------- bookings ----------
    // Members book active trainers for themselves. Afterwards the only change
    // a member can make is cancelling; a trainer can complete or cancel.
    match /bookings/{docId} {
      allow read: if isAdmin()
        || (active() && (resource.data.memberId == request.auth.uid
                           || resource.data.trainerId == request.auth.uid));

      allow create: if active()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'trainerId', 'trainerName',
                                                 'date', 'time', 'sessionType', 'status', 'createdAt'])
        && request.resource.data.status == 'upcoming'
        && request.resource.data.createdAt == request.time
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.time is string && request.resource.data.time.size() <= 10
        && request.resource.data.memberName is string && request.resource.data.memberName.size() <= 80
        && request.resource.data.trainerName is string && request.resource.data.trainerName.size() <= 80
        && get(/databases/$(database)/documents/users/$(request.resource.data.trainerId)).data.role == 'trainer'
        && get(/databases/$(database)/documents/users/$(request.resource.data.trainerId)).data.status == 'active';

      allow update: if isAdmin()
        || (active() && resource.data.status == 'upcoming' && changedOnly(['status']) && (
              (resource.data.memberId == request.auth.uid
                 && request.resource.data.status == 'cancelled') ||
              (resource.data.trainerId == request.auth.uid
                 && request.resource.data.status in ['completed', 'cancelled'])
           ));

      allow delete: if isAdmin();
    }

    // ---------- workouts ----------
    // Personal logs: only the owner can read or change them.
    match /workouts/{docId} {
      allow read, delete: if active() && resource.data.memberId == request.auth.uid;

      allow create: if active()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.keys().hasOnly(['memberId', 'title', 'duration', 'calories',
                                                 'difficulty', 'date', 'exercises', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
        && request.resource.data.exercises is list && request.resource.data.exercises.size() <= 50;

      allow update: if active()
        && resource.data.memberId == request.auth.uid
        && request.resource.data.memberId == request.auth.uid;
    }

    // ---------- payments ----------
    // Written only by the server (phase 2). Members can read their own.
    match /payments/{docId} {
      allow read: if isAdmin() || (active() && resource.data.memberId == request.auth.uid);
      allow write: if false;
    }

    // ---------- settings ----------
    match /settings/{docId} {
      allow read: if active();
      allow write: if isAdmin();
    }
  }
}
